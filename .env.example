# =============================================================================
# ERP Mega Challenge - configuration d'environnement
# Copier ce fichier en .env (cp .env.example .env) puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS etre commite.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="ERP Mega Challenge"
APP_ENV=local
# Genere par `php artisan key:generate`
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Fuseau horaire applicatif (Abidjan, UTC+0 sans heure d'ete)
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Ports exposes par Docker (Sail) -----------------------------------------
# A modifier si un port est deja pris sur votre machine.
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# --- Journaux ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees : MySQL 8 (InnoDB, utf8mb4) -----------------------------
# Avec Sail, DB_HOST doit rester "mysql" (nom du service Docker).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_mega_challenge
DB_USERNAME=sail
DB_PASSWORD=password

# --- Session, cache, files d'attente : Redis ---------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=erp

QUEUE_CONNECTION=redis
# Laravel Horizon supervise les files Redis (http://localhost/horizon)
HORIZON_PREFIX=erp_horizon:

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail : Mailpit en local (interface : http://localhost:8025) -----------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@megachallenge.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Compte administrateur de demonstration (seeder) -------------------------
# Utilise uniquement par `php artisan db:seed`. CHANGER ces valeurs, et ne
# jamais utiliser ce compte tel quel en production.
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@megachallenge.local
ADMIN_PASSWORD=ChangezMoi!2026

# --- Sauvegardes (spatie/laravel-backup) -------------------------------------
# Disque de destination des sauvegardes (voir config/filesystems.php)
BACKUP_DISK=local
# Duree de conservation en jours (cahier des charges : 30 jours)
BACKUP_RETENTION_DAYS=30
# Adresse notifiee en cas d echec de sauvegarde
BACKUP_NOTIFICATION_EMAIL=admin@megachallenge.local

# --- Sail (renseignes automatiquement par ./vendor/bin/sail) ----------------
WWWGROUP=1000
WWWUSER=1000

# Un compte de démonstration par profil (mot de passe = ADMIN_PASSWORD). false en production.
ERP_SEED_DEMO_USERS=true
